<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="xtreamlytv_icon_background">#071014</color>
    <string name="app_description">Open-source Xtream-compatible IPTV player</string>
    <string name="app_name">XtreamlyTV</string>
    <style name="Theme.XtreamlyTV" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorAccent">#20E7C4</item>
        <item name="android:colorPrimary">#20E7C4</item>
        <item name="android:navigationBarColor">#071014</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
    </style>
    <style name="Theme.XtreamlyTV.Starting" parent="Theme.SplashScreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="windowSplashScreenBackground">#071014</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/xtreamlytv_mark_baseline</item>
        <item name="postSplashScreenTheme">@style/Theme.XtreamlyTV</item>
    </style>
</resources>